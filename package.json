{
  "name": "nabz-sim",
  "private": true,
  "type": "module",
  "description": "Browser simulation of Nabz, a weld early-warning retrofit (SPARK Night CH-06)",
  "scripts": {
    "start": "node sim/serve.mjs",
    "test": "node --test sim/*.test.mjs && npm --prefix app test",
